[Unit]
Description=StratiosAI private camera archive uploader and health agent
After=edge-camera-capture.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stratiosai
Group=stratiosai
EnvironmentFile=/etc/edge-camera/pi-agent.env
ExecStart=/opt/edge-ai-lab/.venv/bin/edge-camera-pi-agent --buffer-dir ${EDGE_CAMERA_BUFFER_DIR} --server-url ${EDGE_CAMERA_SERVER_URL} --ingest-token-file ${EDGE_CAMERA_INGEST_TOKEN_FILE} --ca-file /etc/edge-camera/mac-ca.pem
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/etc/edge-camera
ReadWritePaths=/home/stratiosai/edge-camera-buffer

[Install]
WantedBy=multi-user.target
