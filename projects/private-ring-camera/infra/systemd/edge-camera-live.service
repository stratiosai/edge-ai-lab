[Unit]
Description=StratiosAI private camera token-protected live MJPEG relay
After=edge-camera-capture.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stratiosai
Group=stratiosai
EnvironmentFile=/etc/edge-camera/pi-agent.env
ExecStart=/opt/edge-ai-lab/.venv/bin/edge-camera-pi-live --fifo ${EDGE_CAMERA_LIVE_FIFO} --token-file /etc/edge-camera/live-token --tls-cert /etc/edge-camera/pi-live-cert.pem --tls-key /etc/edge-camera/pi-live-key.pem
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/etc/edge-camera
ReadWritePaths=/home/stratiosai/edge-camera-live

[Install]
WantedBy=multi-user.target
